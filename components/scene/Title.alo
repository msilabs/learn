    <div class="cue s-title" data-at="{{ props.el.at }}" data-until="{{ props.el.until }}">
        <b>{{ props.el.text }}</b>
        <template if="props.el.sub"><span>{{ props.el.sub }}</span></template>
    </div>
</template>

