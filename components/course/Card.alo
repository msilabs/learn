<template>
    <a class="card rv" href="/{{ props.course.id }}/" data-topic="{{ props.course.topic }}">
        <Cover
            color="{{ props.course.color }}"
            icon="{{ props.course.icon }}"
            soon="{{ props.course.status === 'soon' }}"
            count="{{ (data[props.course.id] ?? []).length }}"
            unit="পাঠ"
        />
        <div class="body">
            <span class="topic">{{ props.course.topic }}</span>
            <h3>{{ props.course.title }}</h3>
            <p>{{ props.course.description }}</p>
        </div>
    </a>
</template>

<style>
    .card{display:flex;flex-direction:column;gap:18px;padding:12px 12px 22px;border-radius:var(--radius);background:var(--surface);border:1px solid var(--border);text-decoration:none;color:inherit;transition:transform .25s,border-color .25s,background .25s,box-shadow .25s}
    .card:hover{transform:translateY(-4px);border-color:rgba(30,214,168,.35);background:var(--surface-2);box-shadow:0 30px 60px -30px rgba(30,214,168,.35)}
    .body{padding:0 8px}
    .topic{font:600 12px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--mint)}
    h3{font-size:22px;line-height:1.35;margin:10px 0 6px;font-weight:700}
    p{color:var(--muted);font-size:15.5px}

    @media (prefers-reduced-motion:reduce){
        .card{transition:none}
    }
</style>
